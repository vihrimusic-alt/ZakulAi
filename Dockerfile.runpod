# syntax=docker/dockerfile:1
# Separate RunPod Queue image. The existing Dockerfile/API/UI remain unchanged.
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04
COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 LC_ALL=C.UTF-8 \
    UV_LINK_MODE=copy UV_NO_CACHE=1 UV_PYTHON_INSTALL_DIR=/opt/python \
    PYTHONUNBUFFERED=1 TOKENIZERS_PARALLELISM=false \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git build-essential libsndfile1 ffmpeg libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN uv python install 3.11

WORKDIR /app
# Explicit COPY prevents accidentally baking API keys or local output into the image.
COPY pyproject.toml uv.lock README.md /app/
COPY acestep /app/acestep
COPY openrouter /app/openrouter
RUN uv sync --frozen --no-dev --python 3.11

COPY zakul_runpod /app/zakul_runpod
COPY handler.py /app/handler.py
RUN uv export --frozen --no-dev --no-hashes --no-emit-local \
        --output-file /tmp/acestep-constraints.txt --quiet \
    && uv pip install --python /app/.venv/bin/python \
        -r /app/zakul_runpod/requirements.txt -c /tmp/acestep-constraints.txt \
    && uv pip check --python /app/.venv/bin/python \
    && /app/.venv/bin/python -m zakul_runpod.compatibility

ENV ACESTEP_CONFIG_PATH=acestep-v15-turbo \
    ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B \
    ACESTEP_OFFLOAD_TO_CPU=false ACESTEP_LM_OFFLOAD_TO_CPU=false

# No HTTP server, /ping, tunnel, or local queue poller is required for this image.
CMD ["/app/.venv/bin/python", "-u", "/app/handler.py", "--rp_log_level", "INFO"]
